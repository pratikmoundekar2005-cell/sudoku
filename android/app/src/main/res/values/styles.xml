<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme with Obsidian background and zero white flash. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#0F0E13</item>
        <item name="colorPrimaryDark">#0F0E13</item>
        <item name="colorAccent">#9D7BFF</item>
        <item name="android:windowBackground">#0F0E13</item>
        <item name="android:statusBarColor">#0F0E13</item>
        <item name="android:navigationBarColor">#0F0E13</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#0F0E13</item>
        <item name="android:windowBackground">#0F0E13</item>
        <item name="android:statusBarColor">#0F0E13</item>
        <item name="android:navigationBarColor">#0F0E13</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#0F0E13</item>
        <item name="android:windowBackground">#0F0E13</item>
        <item name="android:statusBarColor">#0F0E13</item>
        <item name="android:navigationBarColor">#0F0E13</item>
    </style>
</resources>